{
  "manifest_version": 3,
  "name": "AutoDev — GitHub Profile Score",
  "version": "1.0.0",
  "description": "See any GitHub user's AutoDev score instantly. Analyzes repos, languages, and consistency.",
  "permissions": [],
  "host_permissions": [
    "https://autodev-kappa.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "AutoDev Score",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
