# GitHub API token (required for 5000 req/hr rate limit)
GITHUB_TOKEN=ghp_your_token_here

# Base URL (defaults to https://autodev-kappa.vercel.app)
NEXT_PUBLIC_BASE_URL=https://autodev-kappa.vercel.app

# Razorpay API keys (server-side only — NEVER prefix with NEXT_PUBLIC_)
# Get from: Razorpay Dashboard → Settings → API Keys
# Keep the secret out of the repo, commits, and client code.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret

# Pro price in paise (default 29900 = ₹299 launch offer)
# Set to 74900 to end the launch offer.
PRO_PRICE_PAISE=29900
