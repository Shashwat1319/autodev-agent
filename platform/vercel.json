{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/api/badge(.*)",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml" },
        { "key": "Cache-Control", "value": "s-maxage=3600, stale-while-revalidate" }
      ]
    },
    {
      "source": "/api/og(.*)",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "s-maxage=86400, stale-while-revalidate" }
      ]
    }
  ]
}
